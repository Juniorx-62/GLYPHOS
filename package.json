{
  "name": "glyphos",
  "description": "GLYPHOS — biblioteca de ícones SVG",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "npm run catalog:index && vite dev --port 3100",
    "build": "npm run catalog:index && vite build",
    "preview": "vite preview --port 3100",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./scripts/lib/register-ts.mjs --test \"tests/unit/**/*.test.ts\" \"tests/integration/**/*.test.ts\"",
    "test:e2e": "node tests/e2e/run.mjs",
    "verify": "node scripts/verify.mjs",
    "brand": "node --import ./scripts/lib/register-ts.mjs scripts/brand/generate.ts",
    "check:brand": "node --import ./scripts/lib/register-ts.mjs scripts/brand/generate.ts --check",
    "catalog:index": "node --import ./scripts/lib/register-ts.mjs scripts/catalog/build.ts",
    "catalog:validate": "node --import ./scripts/lib/register-ts.mjs scripts/validation/validate.ts",
    "catalog:format": "node --import ./scripts/lib/register-ts.mjs scripts/catalog/format.ts",
    "catalog:ids": "node --import ./scripts/lib/register-ts.mjs scripts/catalog/ids.ts",
    "catalog:add": "node --import ./scripts/lib/register-ts.mjs scripts/catalog/add.ts",
    "catalog:remove": "node --import ./scripts/lib/register-ts.mjs scripts/catalog/remove.ts",
    "catalog:new": "node --import ./scripts/lib/register-ts.mjs scripts/catalog/new.ts",
    "catalog:import": "node --import ./scripts/lib/register-ts.mjs scripts/catalog/import.ts",
    "catalog:stats": "node --import ./scripts/lib/register-ts.mjs scripts/catalog/stats.ts",
    "catalog:sheet": "node --import ./scripts/lib/register-ts.mjs scripts/generation/sheet.ts",
    "check:deps": "node scripts/validation/check-deps.mjs",
    "check:licenses": "node --import ./scripts/lib/register-ts.mjs scripts/validation/licenses.ts",
    "check:pages": "node scripts/validation/check-pages.mjs",
    "check:seo": "node scripts/seo/check-seo.mjs"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.5",
    "@tanstack/react-virtual": "^3.14.26",
    "nitro": "^3.0.261103-rc",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "svgo": "^4.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
